#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

&led_strip { chain-length = <27>; };

&mt { flavor = "tap-unless-interrupted"; };

/ {
    keymap {
        compatible = "zmk,keymap";

        Base {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BKSP |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            display-name = "BASE";
            bindings = <
&kp TAB    &kp Q  &kp W  &kp E     &kp R  &kp T                         &kp Y        &kp U            &kp I          &kp O    &kp P     &kp BSPC
&kp LSHFT  &kp A  &kp S  &kp D     &kp F  &kp G                         &kp H        &kp J            &kp K          &kp L    &kp SEMI  &kp SQT
&kp LCTRL  &kp Z  &kp X  &kp C     &kp V  &kp B                         &kp N        &kp M            &kp COMMA      &kp DOT  &kp FSLH  &kp ESCAPE
                         &kp LGUI  &mo 3  &mt LS(LC(LA(LGUI))) SPACE    &lt 0 ENTER  &lt 1 BACKSPACE  &kp RIGHT_ALT
            >;
        };

        Num {
            display-name = "NUM";
            bindings = <
&kp TILDE  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp N5       &kp NUMBER_6  &kp N7     &kp N8     &kp N9  &kp N0  &trans
&trans     &trans        &trans        &trans        &trans        &kp EQUAL    &trans        &kp LA(N)  &kp LA(E)  &trans  &trans  &trans
&trans     &trans        &trans        &trans        &trans        &kp BSLH     &trans        &trans     &trans     &trans  &trans  &trans
                                       &kp DOT       &trans        &kp MINUS    &trans        &trans     &trans
            >;
        };

        Sym {
            bindings = <
&kp LS(TILDE)  &kp LS(EXCL)  &kp LS(AT)  &kp LS(POUND)  &kp LS(DLLR)   &kp LS(PRCNT)    &kp LS(CARET)  &kp LS(AMPS)  &kp LS(STAR)  &kp LS(LPAR)  &kp LS(RPAR)  &trans
&trans         &trans        &trans      &kp LS(PLUS)   &kp LS(LBRC)   &kp LBKT         &kp RBKT       &kp LS(RBRC)  &trans        &trans        &trans        &trans
&trans         &trans        &trans      &trans         &kp LS(COLON)  &kp BSLH         &trans         &trans        &trans        &trans        &trans        &trans
                                         &trans         &trans         &kp LS(UNDER)    &trans         &trans        &trans
            >;
        };

        Fun {
            display-name = "FUN";
            bindings = <
&kp LG(TAB)     &bt BT_SEL 0  &bt BT_SEL 1          &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &kp C_VOLUME_UP    &kp C_PREV         &kp C_PP        &kp C_NEXT  &trans     &kp LA(BACKSPACE)
&studio_unlock  &trans        &kp LG(LS(NUMBER_4))  &trans        &trans        &trans          &kp C_VOLUME_DOWN  &kp LEFT_ARROW     &kp DOWN_ARROW  &kp UP      &kp RIGHT  &trans
&bt BT_CLR      &trans        &trans                &trans        &trans        &trans          &trans             &trans             &trans          &trans      &trans     &trans
                                                    &trans        &trans        &trans          &trans             &kp LA(BACKSPACE)  &trans
            >;
        };
    };
};
