#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

&mt { flavor = "balanced"; };


/ {
    keymap {
        compatible = "zmk,keymap";

        Base {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BKSP |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            display-name = "BASE";
            bindings = <
&kp TAB    &kp Q  &kp W  &kp F     &kp P  &kp B                         &kp J        &kp L            &kp U          &kp Y    &kp SEMI  &kp BSPC
&kp LSHFT  &kp A  &kp R  &kp S     &kp T  &kp G                         &kp M        &kp N            &kp E          &kp I    &kp O     &kp APOS
&kp LCTRL  &kp Z  &kp X  &kp C     &kp D  &kp V                         &kp K        &kp H            &kp COMMA      &kp DOT  &kp FSLH  &kp ESC
                         &kp LGUI  &mo 3  &mt LS(LC(LA(LGUI))) SPACE    &lt 2 ENTER  &lt 1 BACKSPACE  &kp RIGHT_ALT
            >;
        };

        Num {
            display-name = "NUM";
            bindings = <
&kp GRAVE  &kp N1  &kp N2  &kp N3     &kp N4  &kp N5       &kp N6  &kp N7     &kp N8     &kp N9  &kp N0  &trans
&trans     &trans  &trans  &kp EQUAL  &trans  &trans       &trans  &kp LA(N)  &kp LA(E)  &trans  &trans  &trans
&trans     &trans  &trans  &trans     &trans  &kp BSLH     &trans  &trans     &trans     &trans  &trans  &trans
                           &kp DOT    &trans  &kp MINUS    &trans  &trans     &trans
            >;

            label = "NUM";
        };

        Sym {
            display-name = "SYM";
            bindings = <
&kp LS(TILDE)  &kp LS(EXCL)  &kp LS(AT)  &kp LS(POUND)  &kp LS(DLLR)      &kp LS(PRCNT)     &kp LS(CARET)    &kp LS(AMPS)       &kp LS(STAR)  &kp LS(LPAR)  &kp LS(RPAR)  &trans
&trans         &trans        &trans      &kp LS(EQUAL)  &kp LEFT_BRACKET  &kp LEFT_BRACE    &kp RIGHT_BRACE  &kp RIGHT_BRACKET  &trans        &trans        &trans        &trans
&trans         &trans        &trans      &trans         &kp COLON         &kp LS(BSLH)      &trans           &trans             &trans        &trans        &trans        &trans
                                         &trans         &trans            &kp LS(MINUS)     &trans           &trans             &trans
            >;

            label = "SYM";
        };

        Fun {
            display-name = "FUN";
            bindings = <
&kp LG(TAB)     &bt BT_SEL 0  &bt BT_SEL 1          &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &kp DOWN_ARROW     &kp RIGHT          &kp C_PREV  &kp C_PLAY_PAUSE  &kp C_NEXT  &kp LA(BACKSPACE)
&studio_unlock  &trans        &kp LG(LS(NUMBER_4))  &trans        &trans        &trans          &kp C_VOLUME_DOWN  &kp LEFT           &kp DOWN    &kp UP            &kp RIGHT   &trans
&bt BT_CLR      &trans        &trans                &trans        &trans        &trans          &kp UP_ARROW       &kp LEFT           &trans      &trans            &trans      &trans
                                                    &trans        &trans        &trans          &trans             &kp LA(BACKSPACE)  &trans
            >;
        };
    };
};
